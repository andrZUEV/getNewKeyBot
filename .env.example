# ---- Telegram ----
# Bot token from @BotFather (/newbot)
BOT_TOKEN=

# Telegram IDs with access, comma separated. Empty = everyone (debug only!)
# Get your ID from @userinfobot
ADMIN_IDS=

# ---- Xray ----
XRAY_CONFIG=/usr/local/etc/xray/config.json
XRAY_SERVICE=xray

# Directory for key text files, relative to bot directory
KEYS_DIR=data/keys

# ---- Entry points (exit is always Prague) ----
