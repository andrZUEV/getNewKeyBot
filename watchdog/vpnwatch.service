[Unit]
Description=Mutual watchdog: heartbeat from partner, alert on silence
Documentation=file:/opt/vpnwatch/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/vpnwatch/watch.py
Restart=always
RestartSec=5
User=root
# Сторож не должен зависеть от xray/бота: он их и проверяет
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
